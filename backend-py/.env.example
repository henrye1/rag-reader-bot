# Python backend environment variables.
# Copy to backend-py/.env and fill in. Never commit the real .env.

# Supabase (server-side — uses the service role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini — required (LLM generation + embeddings)
# Get a key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key

# Anthropic Claude — optional. Required only when a Claude model is selected
# in the UI; Gemini works without it. Get a key:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# LlamaParse — optional, for advanced document parsing
LLAMA_CLOUD_API_KEY=your-llamaparse-api-key

# Server port (defaults to 3001)
PORT=3001
